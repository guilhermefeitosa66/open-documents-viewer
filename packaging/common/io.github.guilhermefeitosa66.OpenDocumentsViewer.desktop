[Desktop Entry]
Type=Application
Name=Open Documents Viewer
GenericName=Document Viewer
Comment=View Markdown, text, code and data files. Fast, offline, read-only.
Exec=open-documents-viewer %F
Icon=io.github.guilhermefeitosa66.OpenDocumentsViewer
Terminal=false
StartupNotify=true
StartupWMClass=io.github.guilhermefeitosa66.OpenDocumentsViewer
Categories=Utility;TextTools;Viewer;
Keywords=markdown;text;code;viewer;csv;json;yaml;toml;env;
MimeType=text/plain;text/markdown;text/x-markdown;text/csv;text/tab-separated-values;application/json;application/x-yaml;application/yaml;text/x-yaml;application/toml;application/xml;text/xml;text/x-python;text/x-python3;application/x-shellscript;text/x-shellscript;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-java;text/x-kotlin;text/x-go;text/rust;text/x-rust;application/javascript;text/javascript;application/x-typescript;text/x-dart;text/x-ruby;application/x-php;text/x-sql;text/css;text/x-scss;text/x-lua;text/x-log;text/x-makefile;text/x-cmake;text/x-dockerfile;application/x-desktop;text/x-ini;application/x-wine-extension-ini;text/x-readme;text/x-changelog;text/x-copying;
