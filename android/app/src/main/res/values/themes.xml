<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paints the window in the document background before Compose draws: no white flash. -->
    <style name="Theme.OpenDocs" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
